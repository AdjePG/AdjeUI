{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "types": ["node"]
  },
  "include": ["AdjeUI.LibraryCore/src", "AdjeUI.Demo", "AdjeUI.LibraryCore/ui.tsx", "AdjeUI.LibraryCore/toast.tsx", "AdjeUI.LibraryCore/PageHeader.tsx"]
}
